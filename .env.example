# 이 파일을 .env.local 로 복사해서 사용한다. (.env.local 은 커밋되지 않는다)
#
# NEXT_PUBLIC_ 접두사가 붙은 값은 빌드 시 클라이언트 번들에 그대로 인라인된다.
# 즉 브라우저에서 누구나 볼 수 있으므로, 비밀값은 절대 여기에 두지 않는다.
# (서버 전용 비밀값 - DB 계정, JWT_SECRET, OAuth client secret 등은 백엔드에만 존재한다)

# 배포된 API 서버의 REST BaseURL. 필수.
NEXT_PUBLIC_API_BASE_URL=https://api.phocamatch.shop/api/v1

# WebSocket(STOMP) 주소. 선택 - 미지정 시 위 BaseURL에서 유도한다 (wss://<host>/ws)
# NEXT_PUBLIC_WS_URL=wss://api.phocamatch.shop/ws
